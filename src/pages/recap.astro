---
import Base from "../layouts/Base.astro";
// LE template de récap : une seule page pour tous les challenges. Elle fetch
// challenges/<c>/challenge.md + leaderboard.json côté client et rend tout —
// rien n'est généré par challenge. Ordre de lecture : les livrables (iframes
// côte à côte), le rapport chiffré, la consigne.
---

<Base title="Récap" wide>
  <div id="etat" class="etat">
    <p class="eyebrow">Récap</p>
    <p class="lede">Chargement du challenge…</p>
  </div>

  <article id="recap" hidden>
    <header class="entete">
      <h1 id="titre"></h1>
      <p class="meta" id="sous-titre"></p>
    </header>

    <section>
      <div id="livrables" class="livrables"></div>
    </section>

    <section id="rapport-section" hidden>
      <h2 class="section-titre">Le rapport</h2>
      <div class="carte">
        <table class="rapport">
          <thead>
            <tr>
              <th>Modèle</th>
              <th class="num">Durée</th>
              <th class="num">Tokens in</th>
              <th class="num">Tokens out</th>
              <th class="num">Total</th>
              <th class="num">Coût estimé</th>
            </tr>
          </thead>
          <tbody id="rapport-lignes"></tbody>
        </table>
        <ul id="analyse" class="analyse"></ul>
      </div>
    </section>

    <section>
      <div class="consigne-entete">
        <h2 class="section-titre">La consigne</h2>
        <button class="btn" id="copier" type="button">Copier</button>
      </div>
      <pre id="consigne" class="carte consigne"></pre>
    </section>
  </article>

  <noscript>
    <p class="lede">Cette page rend les données du challenge côté client — JavaScript requis.</p>
  </noscript>
</Base>

<script>
  const $ = (id) => document.getElementById(id);

  function el(tag, attrs = {}, children = []) {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === "text") n.textContent = v;
      else if (v !== null && v !== undefined) n.setAttribute(k, v);
    }
    for (const c of children) n.append(c);
    return n;
  }

  function fmtTokens(n) {
    if (n == null) return "—";
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + "M";
    if (n >= 1_000) return Math.round(n / 1_000) + "K";
    return String(n);
  }

  function fmtCout(c) {
    if (c == null) return "—";
    return c > 0 ? "$" + c.toFixed(4) : "gratuit";
  }

  function fmtDate(iso) {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso ?? "";
    return d.toLocaleString("fr-CH", { dateStyle: "long", timeStyle: "short", timeZone: "Europe/Zurich" });
  }

  function totalTokens(r) {
    const t = r.tokens;
    if (!t || (t.input_tokens == null && t.output_tokens == null)) return null;
    return (t.input_tokens ?? 0) + (t.output_tokens ?? 0);
  }

  function erreur(message) {
    $("etat").innerHTML = "";
    $("etat").append(
      el("p", { class: "eyebrow", text: "Récap" }),
      el("p", { class: "lede", text: message }),
      el("a", { href: "/", class: "meta", text: "← Tous les challenges" })
    );
  }

  async function existe(url) {
    try {
      const r = await fetch(url, { method: "HEAD" });
      return r.ok;
    } catch {
      return false;
    }
  }

  async function livrable(r) {
    const url = `/challenges/${challengeName}/runs/${r.slug}/index.html`;
    const entete = el("header", { class: "livrable-entete" }, [
      el("h3", { text: r.label ?? r.model }),
    ]);
    const bloc = el("div", { class: "carte livrable" }, [entete]);
    if (await existe(url)) {
      entete.append(
        el("a", { class: "btn", href: url, target: "_blank", rel: "noopener", text: "Ouvrir ↗" })
      );
      bloc.append(el("iframe", { src: url, title: `Livrable — ${r.label}`, loading: "lazy" }));
    } else {
      bloc.append(el("p", { class: "livrable-vide meta", text: "Livrable non publié" }));
    }
    return bloc;
  }

  function ligneRapport(r, focal) {
    const cellule = (val, num, accent) =>
      el("td", { class: [num ? "num" : null, accent ? "accent" : null].filter(Boolean).join(" ") || null, text: val });
    return el("tr", {}, [
      cellule(r.label ?? r.model, false, false),
      cellule(r.duration_seconds != null ? r.duration_seconds + "s" : "—", true, focal),
      cellule(fmtTokens(r.tokens?.input_tokens), true, false),
      cellule(fmtTokens(r.tokens?.output_tokens), true, false),
      cellule(fmtTokens(totalTokens(r)), true, false),
      cellule(fmtCout(r.estimated_cost), true, false),
    ]);
  }

  function lectureComparee(results) {
    const lignes = [];
    const durees = results.filter((r) => r.duration_seconds > 0);
    if (durees.length >= 2) {
      const rapide = durees.reduce((a, b) => (a.duration_seconds <= b.duration_seconds ? a : b));
      const lent = durees.reduce((a, b) => (a.duration_seconds >= b.duration_seconds ? a : b));
      if (lent.duration_seconds > rapide.duration_seconds) lignes.push(
        `Vitesse — ${rapide.label} boucle en ${rapide.duration_seconds}s, ` +
          `${(lent.duration_seconds / rapide.duration_seconds).toFixed(1)}× plus vite que ${lent.label} (${lent.duration_seconds}s).`
      );
    }
    const avecTokens = results.filter((r) => totalTokens(r) > 0);
    if (avecTokens.length >= 2) {
      const gourmand = avecTokens.reduce((a, b) => (totalTokens(a) >= totalTokens(b) ? a : b));
      const sobre = avecTokens.reduce((a, b) => (totalTokens(a) <= totalTokens(b) ? a : b));
      lignes.push(
        `Tokens — ${gourmand.label} consomme ${(totalTokens(gourmand) / totalTokens(sobre)).toFixed(1)}× plus que ` +
          `${sobre.label} (${fmtTokens(totalTokens(gourmand))} contre ${fmtTokens(totalTokens(sobre))}).`
      );
      const debits = avecTokens
        .filter((r) => r.duration_seconds > 0)
        .map((r) => `${r.label} ${Math.round(totalTokens(r) / r.duration_seconds)}/s`);
      if (debits.length >= 2) lignes.push(`Débit — ${debits.join(" · ")}.`);
    }
    return lignes;
  }

  const challengeName = new URLSearchParams(location.search).get("c") ?? "";

  async function main() {
    if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(challengeName)) {
      erreur("Challenge non précisé — passe ?c=<nom-du-challenge> dans l'URL.");
      return;
    }
    const base = `/challenges/${challengeName}`;
    const [mdRes, boardRes] = await Promise.all([fetch(`${base}/challenge.md`), fetch(`${base}/leaderboard.json`)]);
    if (!mdRes.ok) {
      erreur(`Challenge « ${challengeName} » introuvable.`);
      return;
    }
    const consigne = await mdRes.text();
    const board = boardRes.ok ? await boardRes.json() : null;
    const results = board?.results ?? [];

    const titre = consigne.match(/^#\s+(.+)$/m)?.[1]?.trim() ?? challengeName;
    document.title = `${titre} — Model Arena`;
    $("titre").textContent = titre;
    $("sous-titre").textContent = board
      ? `Lancé le ${fmtDate(board.timestamp)} · ${results.length} modèle${results.length > 1 ? "s" : ""}`
      : "Pas encore lancé";

    $("consigne").textContent = consigne;
    $("copier").addEventListener("click", () => {
      navigator.clipboard.writeText(consigne).then(() => {
        $("copier").textContent = "copié";
        setTimeout(() => ($("copier").textContent = "Copier"), 1100);
      });
    });

    if (results.length === 0) {
      $("livrables").append(
        el("p", { class: "lede", text: "Pas encore de résultats — scripts/run-challenge pour lancer l'arène." })
      );
    } else {
      const blocs = await Promise.all(results.map(livrable));
      blocs.forEach((b) => $("livrables").append(b));

      $("rapport-section").hidden = false;
      const durees = results.filter((r) => r.duration_seconds > 0);
      let rapide = durees.length >= 2 ? durees.reduce((a, b) => (a.duration_seconds <= b.duration_seconds ? a : b)) : null;
      // Pas de foyer vermillon en cas d'ex æquo : personne n'est « le plus rapide ».
      if (rapide && durees.some((r) => r !== rapide && r.duration_seconds === rapide.duration_seconds)) rapide = null;
      results.forEach((r) => $("rapport-lignes").append(ligneRapport(r, r === rapide)));
      lectureComparee(results).forEach((l) => $("analyse").append(el("li", { text: l })));
    }

    $("etat").hidden = true;
    $("recap").hidden = false;
  }

  main().catch((e) => {
    console.error(e);
    erreur("Impossible de charger les données du challenge.");
  });
</script>

<style is:global>
  /* Global : le gros de cette page est construit côté client, hors scoping Astro. */
  .entete {
    margin-bottom: var(--space-lg);
  }
  .entete h1 {
    font-size: var(--text-titre);
    margin: 0 0 0.35em;
  }
  .lede {
    color: var(--muted);
  }

  section {
    margin-block: var(--space-lg) var(--space-xl);
  }
  .section-titre {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
  }

  /* Cartes (doctrine composants) : surface détachée, le quadrillage reste visible à travers. */
  .carte {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: rgba(250, 248, 243, 0.03);
    padding: clamp(16px, 2.5vw, 32px);
  }

  /* Les livrables : une carte par modèle, côte à côte dès que la place le permet. */
  .livrables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
    gap: var(--space-lg);
  }
  .livrable {
    max-width: 960px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .livrable-entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .livrable-entete h3 {
    font-size: 1.45rem;
  }
  .livrable iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm, 2px);
    background: #fff;
  }
  .livrable-vide {
    border: 1px dashed var(--rule);
    border-radius: var(--radius-sm, 2px);
    padding: var(--space-lg);
    margin: 0;
    text-align: center;
    flex: 1;
    display: grid;
    place-items: center;
  }
  @media (max-width: 620px) {
    .livrables {
      grid-template-columns: 1fr;
    }
  }

  /* Le rapport : la donnée se lit à l'horizontale, le filet porte les lignes. */
  .rapport {
    width: 100%;
    border-collapse: collapse;
  }
  .rapport th {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-align: left;
    padding: 0 var(--space-md) var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
  }
  .rapport td {
    padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }
  .rapport .num {
    text-align: right;
  }
  .rapport td.accent {
    color: var(--accent);
  }
  .rapport tbody tr {
    transition: background var(--motion-vif) ease;
  }
  .rapport tbody tr:hover {
    background: rgba(250, 248, 243, 0.04);
  }

  .analyse {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }
  .analyse li {
    padding: var(--space-sm) 0;
    color: var(--muted);
  }
  .analyse li + li {
    border-top: 1px solid var(--rule);
  }

  /* La consigne : le texte entier, rien ne défile. */
  .consigne-entete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    max-width: 920px;
  }
  .consigne-entete .section-titre {
    margin-bottom: 0;
  }
  .consigne {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
    max-width: 920px;
  }
</style>
