#!/usr/bin/env bash
set -euo pipefail

NAME="${1:-}"
if [ -z "$NAME" ]; then
  echo "Usage: new-challenge <name>"
  echo ""
  echo "Crée un challenge avec un préfixe de date (YYYY-MM-DD-<name>)"
  echo "Exemple : new-challenge hello-world → challenges/2026-07-10-hello-world/"
  exit 1
fi

DATE_PREFIX=$(date +%Y-%m-%d)
DIR_NAME="${DATE_PREFIX}-${NAME}"
DIR="challenges/$DIR_NAME"

if [ -d "$DIR" ]; then
  echo "Error: $DIR already exists"
  exit 1
fi

mkdir -p "$DIR/runs"

cat > "$DIR/challenge.md" << CHALLENGE
# $NAME

## Contexte

Décris le contexte ici.

## Consigne

Explique clairement ce que l'agent doit faire.

## Critères d'évaluation

- critère 1
- critère 2
- critère 3

## Format de sortie attendu

Décris ce que l'agent doit produire (fichiers, code, texte, etc.).
CHALLENGE

cat > "$DIR/models.json" << MODELS
{
  "models": [
    {
      "id": "opencode/deepseek-v4-flash-free",
      "provider": "opencode",
      "label": "DeepSeek V4 Flash (gratuit)"
    },
    {
      "id": "opencode/mimo-v2.5-free",
      "provider": "opencode",
      "label": "Mimo v2.5 (gratuit)"
    }
  ]
}
MODELS

echo "✓ Challenge '$DIR_NAME' créé dans $DIR/"
echo "  → Édite $DIR/challenge.md pour définir la tâche"
echo "  → Configure $DIR/models.json pour lister les modèles"
echo "  → Lance avec : bash scripts/run-challenge $DIR_NAME"
