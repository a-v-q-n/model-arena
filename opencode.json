{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./skills"]
  },
  "agent": {
    "arena-sonnet": {
      "model": "openrouter/anthropic/claude-sonnet-4",
      "mode": "subagent",
      "description": "Arena agent — Claude Sonnet 4"
    },
    "arena-gpt4o": {
      "model": "openrouter/openai/gpt-4o",
      "mode": "subagent",
      "description": "Arena agent — GPT-4o"
    },
    "arena-haiku": {
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "mode": "subagent",
      "description": "Arena agent — Claude Haiku 4.5"
    },
    "arena-gpt4o-mini": {
      "model": "openrouter/openai/gpt-4o-mini",
      "mode": "subagent",
      "description": "Arena agent — GPT-4o Mini"
    },
    "arena-deepseek": {
      "model": "openrouter/deepseek/deepseek-chat",
      "mode": "subagent",
      "description": "Arena agent — DeepSeek Chat"
    }
  },
  "command": {
    "new-challenge": {
      "template": "bash scripts/new-challenge {input}",
      "description": "Create a new arena challenge",
      "subtask": false
    },
    "run-challenge": {
      "template": "bash scripts/run-challenge {input}",
      "description": "Run an arena challenge against all models",
      "subtask": false
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}
